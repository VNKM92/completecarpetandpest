// Prisma Schema for Brisbane Carpet & Pest Experts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 1. RBAC & USER MANAGEMENT
// ----------------------------------------------------

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  avatar        String?        @db.Text
  status        String         @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  roleId        String?
  role          Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  customer      Customer?
  employee      Employee?
  notifications Notification[]
  activityLogs  ActivityLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String?          @db.Text
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique // e.g. "services:create", "enquiries:manage"
  category    String // e.g. "Services", "Bookings", "Settings"
  description String?          @db.Text
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ----------------------------------------------------
// 2. CRM, CUSTOMER, QUOTATIONS & BOOKINGS
// ----------------------------------------------------

model Customer {
  id           String               @id @default(cuid())
  userId       String?              @unique
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String               @unique
  phone        String?
  address      String?              @db.Text
  suburb       String?
  postcode     String?
  notes        String?              @db.Text
  bookings     Booking[]
  orders       Order[]
  invoices     Invoice[]
  payments     PaymentTransaction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Enquiry {
  id            String   @id @default(cuid())
  enquiryNumber String?  @unique
  firstName     String
  lastName      String
  email         String
  phone         String
  service       String?
  bedrooms      String?
  bathrooms     String?
  message       String?  @db.Text
  status        String   @default("NEW") // NEW, CONTACTED, QUOTED, CLOSED, SPAM
  isRead        Boolean  @default(false)
  notes         String?  @db.Text
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Booking {
  id                 String               @id @default(cuid())
  bookingNumber      String               @unique
  customerId         String?
  customer           Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String
  customerPhone      String
  serviceId          String?
  serviceName        String
  serviceAddress     String               @db.Text
  suburb             String?
  postcode           String?
  scheduledDate      DateTime?
  timeSlot           String?              // e.g. "Morning (8AM - 11AM)", "Midday (11AM - 2PM)", "Afternoon (2PM - 5PM)"
  squareFootage      Int?
  rooms              Int?
  bathrooms          Int?
  addons             String?              @db.Text // JSON string array of addons
  totalPrice         Float                @default(0)
  approvedPrice      Float?
  depositRequired    Float                @default(50.0) // Standard 50 AUD deposit
  depositPaid        Float                @default(0.0)
  balanceDue         Float                @default(0.0)
  quoteStatus        String               @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, CONVERTED
  status             String               @default("PENDING") // PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED
  paymentStatus      String               @default("UNPAID") // UNPAID, DEPOSIT_PAID, FULLY_PAID, REFUNDED
  paymentGateway     String?              // STRIPE, PAYPAL, POLI, PAYID, AFTERPAY, BANK_TRANSFER, CASH
  notes              String?              @db.Text
  adminNotes         String?              @db.Text
  rejectionReason    String?              @db.Text
  reminderSent2Days  Boolean              @default(false)
  reminderSentDate   DateTime?
  reminderMobileOpt  Boolean              @default(true)
  reminderEmailOpt   Boolean              @default(true)
  assignedEmployeeId String?
  assignedEmployee   Employee?            @relation("PrimaryTechnician", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  crew               BookingCrewMember[]  // Crew of 1 to 5+ field specialists/cleaners
  order              Order?
  jobReport          JobReport?
  invoices           Invoice[]
  payments           PaymentTransaction[]
  reminderLogs       ReminderLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model BookingCrewMember {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role        String    @default("Technician") // "Lead Specialist", "Steam Cleaning Specialist", "Pest Controller", "Bond Cleaner", "Quality Inspector", "Assistant"
  isLead      Boolean   @default(false)
  assignedAt  DateTime  @default(now())
  notes       String?   @db.Text

  @@unique([bookingId, employeeId])
}

model Order {
  id            String    @id @default(cuid())
  orderNumber   String    @unique
  bookingId     String?   @unique
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal      Float
  discount      Float     @default(0)
  tax           Float     @default(0)
  totalAmount   Float
  paymentStatus String    @default("UNPAID") // UNPAID, PARTIAL, PAID, REFUNDED
  paymentMethod String?   // INVOICE, CARD, CASH, BANK_TRANSFER
  paymentDate   DateTime?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ----------------------------------------------------
// 3. INVOICING & BILLING & PAYMENTS (AUSTRALIA GST READY)
// ----------------------------------------------------

model Invoice {
  id              String               @id @default(cuid())
  invoiceNumber   String               @unique
  bookingId       String?
  booking         Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String?
  customerAddress String?              @db.Text
  subtotal        Float                @default(0)
  gstRate         Float                @default(10.0) // 10% Australia GST
  gstAmount       Float                @default(0)
  discount        Float                @default(0)
  totalAmount     Float                @default(0)
  depositPaid     Float                @default(0)
  balanceDue      Float                @default(0)
  status          String               @default("UNPAID") // DRAFT, SENT, PARTIAL, PAID, CANCELLED
  paymentMethod   String?              // STRIPE, PAYPAL, POLI, PAYID, AFTERPAY, BANK_TRANSFER, CASH
  issuedDate      DateTime             @default(now())
  dueDate         DateTime?
  notes           String?              @db.Text
  terms           String?              @default("Payment due upon receipt. ABN: 45 892 103 441. Brisbane Carpet & Pest Experts.") @db.Text
  items           InvoiceItem[]
  payments        PaymentTransaction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String   @db.Text
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  totalPrice  Float    @default(0)
}

model PaymentTransaction {
  id                String    @id @default(cuid())
  transactionNumber String    @unique
  bookingId         String?
  booking           Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoiceId         String?
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount            Float
  currency          String    @default("AUD")
  paymentGateway    String    // STRIPE, PAYPAL, POLI, PAYID, AFTERPAY, BANK_TRANSFER, CASH
  paymentType       String    @default("DEPOSIT") // DEPOSIT, FULL_PAYMENT, BALANCE_PAYMENT
  status            String    @default("SUCCESS") // SUCCESS, PENDING, FAILED, REFUNDED
  gatewayRef        String?   // Stripe Charge ID, PayPal Order ID, Bank Ref
  payerEmail        String?
  notes             String?   @db.Text
  metadata          String?   @db.LongText // JSON details
  createdAt         DateTime  @default(now())
}

// ----------------------------------------------------
// 4. HRM & EMPLOYEE / FIELD TECHNICIAN MANAGEMENT
// ----------------------------------------------------

model Employee {
  id               String              @id @default(cuid())
  employeeCode     String              @unique // e.g. "EMP-101"
  userId           String?             @unique
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  email            String              @unique
  phone            String
  designation      String              // "Senior Carpet Cleaning Tech", "Licensed Pest Exterminator", "Bond Cleaning Inspector"
  department       String              @default("Cleaning & Pest Control") // Carpet, Pest, Bond, Inspection, Operations
  status           String              @default("ACTIVE") // ACTIVE, ON_LEAVE, INACTIVE
  hourlyRate       Float               @default(35.0)
  skills           String?             @db.Text // JSON array of certified skills e.g. ["Steam Carpet", "Pest Management", "Tile Cleaning"]
  emergencyContact String?             @db.Text
  address          String?             @db.Text
  licenseNumber    String?             // QLD Pest Management License or White Card
  joinDate         DateTime            @default(now())
  assignedBookings Booking[]           @relation("PrimaryTechnician")
  crewAssignments  BookingCrewMember[] // All crew assignments where this employee is working
  jobReports       JobReport[]
  attendances      Attendance[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime  @default(now())
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("PRESENT") // PRESENT, ABSENT, LEAVE, HALF_DAY
  workNotes   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, date])
}

model JobReport {
  id                String     @id @default(cuid())
  bookingId         String     @unique
  booking           Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employeeId        String?
  employee          Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  visitTime         DateTime?
  completionTime    DateTime?
  status            String     @default("SCHEDULED") // SCHEDULED, ARRIVED, IN_PROGRESS, COMPLETED, ISSUE_REPORTED
  workDescription   String?    @db.Text
  faultNotes        String?    @db.Text // Description of pre-existing faults/stains/infestations noticed on arrival
  treatmentApplied  String?    @db.Text // E.g. "High heat extraction + Termiticide barrier spray"
  checklist         String?    @db.Text // JSON array of completed inspection checks
  customerSignature String?    @db.LongText // Base64 or URL
  summaryNotes      String?    @db.Text
  photos            JobPhoto[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model JobPhoto {
  id          String    @id @default(cuid())
  jobReportId String
  jobReport   JobReport @relation(fields: [jobReportId], references: [id], onDelete: Cascade)
  photoUrl    String    @db.Text
  type        String    @default("BEFORE") // BEFORE, DURING, AFTER, FAULT_EVIDENCE
  caption     String?   @db.Text
  uploadedBy  String?   // Name or Employee Code
  createdAt   DateTime  @default(now())
}

// ----------------------------------------------------
// 5. REMINDERS & NOTIFICATIONS
// ----------------------------------------------------

model ReminderLog {
  id             String    @id @default(cuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recipientEmail String
  recipientPhone String?
  channel        String    // EMAIL, SMS, IN_APP, ALL
  scheduledFor   DateTime
  sentAt         DateTime?
  status         String    @default("SENT") // PENDING, SENT, FAILED
  error          String?   @db.Text
  createdAt      DateTime  @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  roleTarget String?   // "CUSTOMER", "EMPLOYEE", "ADMIN", "ALL"
  title      String
  message    String    @db.Text
  type       String    @default("INFO") // INFO, SUCCESS, WARNING, ERROR, QUOTE, PAYMENT, REMINDER
  link       String?   @db.Text
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

// ----------------------------------------------------
// 6. SERVICES, CATEGORIES & CMS
// ----------------------------------------------------

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  icon        String?   @db.Text
  order       Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  categoryId     String?
  category       ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shortDesc      String?          @db.Text
  description    String?          @db.LongText
  priceStarting  Float?
  priceUnit      String?          @default("Fixed") // Hourly, Sqm, Room, Fixed
  duration       String?          // e.g. "2-3 hours"
  icon           String?          @db.Text
  heroImage      String?          @db.Text
  gallery        String?          @db.LongText // JSON string array of image URLs
  features       String?          @db.LongText // JSON string array of bullet points
  tabData        String?          @db.LongText // JSON string for tabs (residential, commercial, outdoor)
  metaTitle      String?          @db.Text
  metaDesc       String?          @db.Text
  metaKeywords   String?          @db.Text
  canonicalUrl   String?          @db.Text
  ogImage        String?          @db.Text
  schemaType     String?          @default("CleaningService")
  isFeatured     Boolean          @default(false)
  isActive       Boolean          @default(true)
  order          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Page {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  heading      String?  @db.Text
  subheading   String?  @db.Text
  content      String?  @db.LongText // HTML or Markdown
  bannerImage  String?  @db.Text
  metaTitle    String?  @db.Text
  metaDesc     String?  @db.Text
  metaKeywords String?  @db.Text
  canonicalUrl String?  @db.Text
  ogImage      String?  @db.Text
  robots       String?  @default("index, follow")
  customSchema String?  @db.LongText // JSON-LD custom string
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BlogCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  excerpt      String?       @db.Text
  content      String        @db.LongText // HTML or Markdown
  featuredImg  String?       @db.Text
  author       String        @default("Brisbane Carpet & Pest Experts")
  readTime     Int           @default(5)
  categoryId   String?
  category     BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         String?       @db.Text // Comma-separated or JSON
  metaTitle    String?       @db.Text
  metaDesc     String?       @db.Text
  metaKeywords String?       @db.Text
  canonicalUrl String?       @db.Text
  ogImage      String?       @db.Text
  status       String        @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt  DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model FaqCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  faqs      Faq[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id         String       @id @default(cuid())
  question   String       @db.Text
  answer     String       @db.LongText
  categoryId String?
  category   FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  serviceTag String?      // Optional tag linking FAQ to a specific service or page
  order      Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  role       String?  @default("Client")
  location   String?  @default("Brisbane")
  avatar     String?  @db.Text
  rating     Int      @default(5)
  review     String   @db.LongText
  source     String?  @default("Google")
  isApproved Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String   @db.Text
  mimeType  String?
  size      Int?
  altText   String?  @db.Text
  folder    String?  @default("general")
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  recipient String
  subject   String
  body      String?  @db.LongText
  status    String   @default("SENT") // SENT, FAILED, QUEUED
  error     String?  @db.Text
  createdAt DateTime @default(now())
}

model WhatsappLog {
  id        String   @id @default(cuid())
  phone     String
  message   String   @db.LongText
  direction String   @default("OUTBOUND") // INBOUND, OUTBOUND
  status    String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, EXPORT, STATUS_CHANGE, APPROVAL, PAYMENT
  module     String   // Services, Bookings, Quotations, Invoices, HRM, Employee, Payments, Settings, Auth
  entityId   String?
  details    String?  @db.LongText // JSON formatted string with diff or context
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.LongText // JSON or string value
  group     String   @default("general") // general, contact, seo, header, footer, booking, social, payment
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
